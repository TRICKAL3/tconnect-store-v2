# Copy to `.env` and fill in values. Never commit real secrets.

DATABASE_URL=

# Hosted checkout (server-side only). Secret is used as Bearer token to start and verify payments.
PAYCHANGU_SECRET_KEY=
# Optional publishable key if you add client-side flows later.
PAYCHANGU_PUBLIC_KEY=

# Public base URL of this API so the processor can POST callbacks (use ngrok in local dev).
PAYCHANGU_CALLBACK_API_BASE=

# Storefront URL for redirects after checkout (match your dev port, e.g. http://localhost:3180)
FRONTEND_URL=http://localhost:3180

# PawaPay (mobile money) — API token from pawaPay Dashboard → API tokens (use live token for verified account)
PAWAPAY_API_TOKEN=
# live | sandbox (use live when your account is verified for production)
PAWAPAY_MODE=live
# HTTPS checkout URL where PawaPay sends the customer after payment (required; not localhost)
PAWAPAY_RETURN_URL=https://your-app.vercel.app/checkout
# Public API base for deposit callbacks, e.g. https://your-app.vercel.app/api (ngrok in local dev)
PAWAPAY_CALLBACK_API_BASE=
# ISO 3166-1 alpha-3 country on payment page (Malawi = MWI)
PAWAPAY_COUNTRY=MWI

# Admin alerts via email (comma-separated recipients).
# Requires SMTP_* variables configured on the deployment.
# ADMIN_ALERT_EMAILS=you@gmail.com,team@example.com
# Used for new orders + new live chat customer messages.

# Customer notification emails (same SMTP_* as above).
# Sends an email for every in-app user notification (orders, chat, spin, wallet, promos).
# Set to false to disable without removing SMTP.
# USER_EMAIL_NOTIFICATIONS=true

# Reloadly — gift cards, airtime, utilities (https://developers.reloadly.com/)
# Sandbox credentials: Reloadly dashboard → Developers → API Settings (toggle Sandbox)
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

