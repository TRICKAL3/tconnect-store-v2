{
  "name": "tconnect-store-v2",
  "version": "2.0.0",
  "description": "TConnect Store v2.0 - Gift Cards & Crypto Purchases",
  "private": true,
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.78.0",
    "@types/node": "^16.18.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "firebase": "^12.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.263.1",
    "nodemailer": "^7.0.11",
    "postcss": "^8.4.21",
    "prisma": "^5.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.3.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^4.9.0",
    "web-vitals": "^2.1.0",
    "zod": "^3.23.8"
  },
  "scripts": {
    "local": "concurrently -n api,web -c blue,green \"npm run backend:dev\" \"wait-on -t 120000 http://127.0.0.1:4001/health && npm run start\"",
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "prisma generate && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "prisma generate",
    "build:api": "tsc --project api/tsconfig.json",
    "start:api": "tsc -p api/tsconfig.server.json && node api/dist/server/dev-server.js",
    "backend:dev": "npm --prefix backend run dev",
    "clean": "node -e \"try{require('fs').rmSync('node_modules/.cache',{recursive:true,force:true});console.log('Cache cleared');}catch(e){console.log('No cache or error:',e.message);}\"",
    "start:fresh": "npm run clean && npm start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^27.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@vercel/node": "^3.2.29",
    "baseline-browser-mapping": "latest",
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.5"
  }
}
